# MARK: - MCP over stdio


def reply(id, result=None, error=None):
    message = {"jsonrpc": "2.0", "id": id}
    if error is not None:
        message["error"] = error
    else:
        message["result"] = result
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


def call(name, args):
    handler = HANDLERS.get(name)
    if handler is None:
        return {
            "content": [{"type": "text", "text": json.dumps({"error": {"code": "no_tool", "message": name}})}],
            "isError": True,
        }
    try:
        out = handler(args or {})
    except Refusal as refusal:
        return {"content": [{"type": "text", "text": json.dumps(refusal.said())}], "isError": True}
    except Exception as error:  # noqa: BLE001 (a tool's own bug: said, and the server goes on)
        log(f"{name}: {type(error).__name__}: {error}")
        said = {"error": {"code": "internal", "message": f"{type(error).__name__}: {error}"}}
        return {"content": [{"type": "text", "text": json.dumps(said)}], "isError": True}
    if isinstance(out, list):
        return {"content": out}
    return {"content": [{"type": "text", "text": json.dumps(out, ensure_ascii=False)}]}


def serve():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            reply(None, error={"code": -32700, "message": "parse error"})
            continue
        method, id = message.get("method"), message.get("id")
        if id is None:
            continue  # a notification: initialized, cancelled
        params = message.get("params") or {}
        if method == "initialize":
            asked = params.get("protocolVersion")
            reply(
                id,
                {
                    "protocolVersion": asked if asked in VERSIONS else VERSIONS[-1],
                    "capabilities": {"tools": {"listChanged": False}},
                    "serverInfo": {"name": "search-bench", "version": "0.1.0"},
                    "instructions": INSTRUCTIONS,
                },
            )
        elif method == "ping":
            reply(id, {})
        elif method == "tools/list":
            reply(id, {"tools": [{"name": n, "description": d, "inputSchema": schema} for n, _, d, schema in TOOLS]})
        elif method == "tools/call":
            reply(id, call(params.get("name"), params.get("arguments")))
        else:
            reply(id, error={"code": -32601, "message": f"no method {method}"})


def main():
    def stop(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    try:
        serve()
    except KeyboardInterrupt:
        pass
    finally:
        # Whatever the client left open goes with the server.
        for s in list(sessions.values()):
            try:
                finish(s)
            except Exception as error:  # noqa: BLE001
                log(f"closing {s.id}: {error}")


if __name__ == "__main__":
    main()
