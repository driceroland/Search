class Refusal(Exception):
    """What a tool says when it won't or can't: a code an agent can branch
    on, what happened, and what to do instead."""

    def __init__(self, code, message, hint=""):
        super().__init__(message)
        self.code, self.message, self.hint = code, message, hint

    def said(self):
        out = {"code": self.code, "message": self.message}
        if self.hint:
            out["hint"] = self.hint
        return {"error": out}


def log(*words):
    print("bench-mcp:", *words, file=sys.stderr, flush=True)


# MARK: - a world


def named(world):
    """A world's name the way Store.world and ./bench make it."""
    world = "".join(c for c in str(world).lower() if c.isascii() and (c.isalnum() or c == "-"))
    return "test" if world in ("", "1") else world


def folder(world):
    return f"{SUPPORT}/Search ({world})"


def suite(world):
    return "com.officecommun.search.test" if world == "test" else f"com.officecommun.search.test.{world}"


def socket_of(world):
    return f"{folder(world)}/bench.sock"


def ask(world, request, patience=35.0):
    """One request on the world's socket, one answer, as ./bench asks."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(patience)
        try:
            s.connect(socket_of(world))
        except (FileNotFoundError, ConnectionRefusedError):
            raise Refusal("not_listening", f"Search ({world}) isn't listening", "Call open_session.") from None
        s.sendall((json.dumps(request) + "\n").encode())
        chunks = []
        try:
            while True:
                chunk = s.recv(1 << 16)
                if not chunk:
                    break
                chunks.append(chunk)
        except socket.timeout:  # noqa: UP041 (TimeoutError only from 3.10)
            raise Refusal("no_answer", f"{request.get('do')} got no answer within {int(patience)} s") from None
    answer = json.loads(b"".join(chunks).split(b"\n", 1)[0] or b"{}")
    # A test run that let a window onto a screen has failed, whatever it was doing.
    if answer.get("onScreen"):
        raise Refusal(
            "window_on_screen",
            "A window came onto a screen: " + "; ".join(answer["onScreen"]),
            "This world is spoiled. close_session, then open_session.",
        )
    if "error" in answer:
        said = str(answer["error"])
        if said.startswith("no tab"):
            raise Refusal("stale_page", "That page's tab is gone", "Use list_tabs.")
        raise Refusal("bench", said)
    return answer


def listening(world):
    try:
        ask(world, {"do": "tabs"}, patience=5)
        return True
    except (Refusal, OSError, ValueError):
        return False


def running():
    """Every process from this build, a probe or not."""
    out = subprocess.run(["pgrep", "-f", APP + "/Contents/MacOS"], capture_output=True, text=True, check=False).stdout
    return set(out.split())


def holding(world):
    sock = socket_of(world)
    if not os.path.exists(sock):
        return set()
    return set(subprocess.run(["lsof", "-t", "--", sock], capture_output=True, text=True, check=False).stdout.split())


def probe(pid):
    """Whether a process holds some world's bench socket: a test run, not
    someone's Search."""
    names = subprocess.run(["lsof", "-a", "-U", "-p", pid, "-Fn"], capture_output=True, text=True, check=False).stdout
    return any(n.startswith("n") and "/Search (" in n and n.endswith("/bench.sock") for n in names.splitlines())


def loaded(path):
    with open(path) as f:
        return json.load(f)


def stores(world):
    """The WebKit stores a world's runs made, named as the app names them
    (Store.probeStore, Spaces.store, Profiles.store): the same list
    Tests/split_view.py removes."""
    h = 0
    if world != "test":
        h = 2166136261
        for byte in world.encode():
            h = ((h ^ byte) * 16777619) & 0xFFFFFFFF

    def probe_id(kind):
        return f"5E4C{h >> 16:04X}-{h & 0xFFFF:04X}-4000-8000-{kind:012X}"

    found = [f"{WEBKIT}/WebsiteDataStore/{probe_id(1).lower()}", f"{WEBKIT}/WebExtensions/{probe_id(2)}"]
    ids = []
    for name, keep in (
        ("spaces.json", lambda x: x.get("sharesSignIns") is not True),
        ("profiles.json", lambda x: x.get("id") != PERSONAL),
    ):
        try:
            ids += [x["id"] for x in loaded(f"{folder(world)}/{name}") if keep(x)]
        except (OSError, ValueError, TypeError, KeyError, AttributeError):
            pass
    erasing = subprocess.run(
        ["defaults", "read", suite(world), "spaces.erasing"], capture_output=True, text=True, check=False
    ).stdout
    ids += re.findall(r"[0-9A-Fa-f]{8}-(?:[0-9A-Fa-f]{4}-){3}[0-9A-Fa-f]{12}", erasing)
    for id in ids:
        try:
            id = str(uuid.UUID(id))
        except (ValueError, AttributeError, TypeError):
            continue
        if id != FIRST_SPACE:
            found.append(f"{WEBKIT}/WebsiteDataStore/{id}")
    return found


def guarded():
    """Store ids no wipe removes: the real Search's spaces and profiles, and
    the fixed ones."""
    ids = {FIRST_SPACE, PERSONAL.lower()}
    for name in ("spaces.json", "profiles.json"):
        try:
            ids |= {str(uuid.UUID(x["id"])) for x in loaded(f"{REAL}/{name}")}
        except (OSError, ValueError, TypeError, KeyError, AttributeError):
            pass
    return ids


def wipe(world):
    # Only a world this server named; the stores first, since which spaces
    # had one is in the folder and settings about to go.
    if not world.startswith("agent-"):
        return
    keep = guarded()
    for path in stores(world):
        if os.path.basename(path).lower() in keep:
            log(f"not removing {path}: the real Search uses that id")
            continue
        shutil.rmtree(path, ignore_errors=True)
    shutil.rmtree(folder(world), ignore_errors=True)
    subprocess.run(["defaults", "delete", suite(world)], capture_output=True, check=False)


# MARK: - what runs in the page

# In Search's own content world (Tab.world) when the server asks for it:
# the page's DOM, none of its globals, so the element list kept between
# calls is out of the page's reach. Shared by read_page, the element tools
# and wait_for.
HELPERS = r"""
var ROLES = {button:1, link:1, checkbox:1, radio:1, switch:1, tab:1, menuitem:1, menuitemcheckbox:1,
  menuitemradio:1, option:1, combobox:1, textbox:1, searchbox:1, slider:1, spinbutton:1, listbox:1,
  heading:1, dialog:1, alertdialog:1, alert:1, treeitem:1, gridcell:1, iframe:1};
var SEL = 'a[href],area[href],button,input:not([type=hidden]),select,textarea,summary,[contenteditable],' +
  '[role],[tabindex],h1,h2,h3,h4,h5,h6,iframe';
function squash(s) { return String(s == null ? '' : s).replace(/\s+/g, ' ').trim().slice(0, 160); }
function visible(el) {
  var r = el.getBoundingClientRect();
  if (r.width === 0 && r.height === 0) return false;
  if (el.checkVisibility && !el.checkVisibility({ checkOpacity: true, checkVisibilityCSS: true })) return false;
  return !el.closest('[aria-hidden=true],[inert]');
}
function role(el) {
  var r = (el.getAttribute('role') || '').trim().split(/\s+/)[0];
  if (r && r !== 'none' && r !== 'presentation') return r;
  var t = el.tagName.toLowerCase();
  if (t === 'a' || t === 'area') return el.hasAttribute('href') ? 'link' : 'generic';
  if (t === 'button' || t === 'summary') return 'button';
  if (t === 'select') return el.multiple || el.size > 1 ? 'listbox' : 'combobox';
  if (t === 'textarea') return 'textbox';
  if (/^h[1-6]$/.test(t)) return 'heading';
  if (t === 'iframe') return 'iframe';
  if (t === 'input') {
    return {checkbox: 'checkbox', radio: 'radio', range: 'slider', number: 'spinbutton', search: 'searchbox',
      submit: 'button', button: 'button', reset: 'button', image: 'button', file: 'button',
      color: 'button'}[(el.type || 'text').toLowerCase()] || 'textbox';
  }
  if (el.isContentEditable) return 'textbox';
  return 'generic';
}
function name(el) {
  var by = el.getAttribute('aria-labelledby'), t = el.tagName.toLowerCase(), s;
  if (by) {
    s = squash(by.split(/\s+/).map(function (id) {
      var n = document.getElementById(id); return n ? n.innerText || n.textContent : '';
    }).join(' '));
    if (s) return s;
  }
  if ((s = squash(el.getAttribute('aria-label')))) return s;
  if (/^(input|textarea|select)$/.test(t) && el.labels && el.labels.length &&
      (s = squash(Array.prototype.map.call(el.labels, function (l) { return l.innerText; }).join(' ')))) return s;
  if (t === 'input' && /^(submit|button|reset)$/i.test(el.type)) return squash(el.value || el.type);
  if (t === 'input' && /^image$/i.test(el.type)) return squash(el.alt || el.value);
  if (t === 'area') return squash(el.alt);
  if (t === 'iframe') return squash(el.title || el.src);
  if (!/^(input|textarea|select)$/.test(t)) {
    if ((s = squash(el.innerText))) return s;
    var img = el.querySelector('img[alt]');
    if (img && (s = squash(img.alt))) return s;
  }
  return squash(el.getAttribute('placeholder') || el.getAttribute('title'));
}
function secret(el) {
  if (el.tagName !== 'INPUT') return false;
  if ((el.type || '').toLowerCase() === 'password') return true;
  return /(^|\s)(cc-|one-time-code|current-password|new-password)/.test(el.getAttribute('autocomplete') || '');
}
function editable(el) {
  if (el.isContentEditable) return true;
  if (el.tagName === 'TEXTAREA') return true;
  return el.tagName === 'INPUT' &&
    !/^(checkbox|radio|submit|button|reset|image|file|range|color|hidden)$/i.test(el.type || 'text');
}
function wanted(el) {
  var r = role(el);
  if (ROLES[r]) return r;
  var ti = el.getAttribute('tabindex');
  return ti !== null && +ti >= 0 ? r : null;
}
function candidates() {
  // The document's, then each open shadow root's: a closed one is the
  // page's own business.
  var out = [], roots = [document];
  while (roots.length) {
    var root = roots.shift();
    Array.prototype.push.apply(out, root.querySelectorAll(SEL));
    var all = root.querySelectorAll('*');
    for (var i = 0; i < all.length; i++) if (all[i].shadowRoot) roots.push(all[i].shadowRoot);
  }
  return out;
}
function described(el) {
  var s = el.tagName.toLowerCase();
  if (el.id) s += '#' + el.id;
  if (typeof el.className === 'string' && el.className.trim()) s += '.' + el.className.trim().split(/\s+/).slice(0, 2).join('.');
  return s;
}
"""

READ = (
    HELPERS
    + r"""
(function (snap, most, longest, withText) {
  var found = candidates(), els = [], nodes = [], cut = false, vw = innerWidth, vh = innerHeight;
  for (var i = 0; i < found.length; i++) {
    var el = found[i], r0 = wanted(el);
    if (!r0 || !visible(el)) continue;
    if (nodes.length >= most) { cut = true; break; }
    var r = el.getBoundingClientRect(), n = { e: els.length, role: r0, name: name(el) };
    if (r0 === 'heading') n.level = +(el.getAttribute('aria-level') || el.tagName.slice(1)) || 2;
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) && !/^(submit|button|reset|image|checkbox|radio)$/i.test(el.type || '')) {
      if (secret(el)) { n.redacted = true; n.filled = !!el.value; } else n.value = String(el.value).slice(0, 500);
    } else if (el.isContentEditable) n.value = String(el.innerText).slice(0, 500);
    if (/^(checkbox|radio)$/i.test(el.type || '') && el.tagName === 'INPUT') n.checked = el.checked;
    ['checked', 'expanded', 'selected', 'pressed'].forEach(function (k) {
      var v = el.getAttribute('aria-' + k); if (v === 'true' || v === 'false') n[k] = v === 'true';
    });
    if (el.disabled || el.getAttribute('aria-disabled') === 'true') n.disabled = true;
    if (el.readOnly) n.readonly = true;
    if (el.tagName === 'A' && el.href) n.href = String(el.href).slice(0, 300);
    if (el.getRootNode() !== document) n.shadow = true;
    n.box = [Math.round(r.left), Math.round(r.top), Math.round(r.width), Math.round(r.height)];
    n.inView = r.bottom > 0 && r.right > 0 && r.top < vh && r.left < vw;
    els.push(el); nodes.push(n);
  }
  globalThis.__benchMCP = { snap: snap, els: els };
  var out = { url: location.href, title: document.title, nodes: nodes, nodesTruncated: cut,
    viewport: { width: vw, height: vh, scrollY: Math.round(scrollY),
      scrollHeight: document.documentElement ? document.documentElement.scrollHeight : 0 } };
  if (withText) {
    var text = document.body ? document.body.innerText : '';
    out.textTruncated = text.length > longest;
    out.text = text.slice(0, longest);
  }
  return JSON.stringify(out);
})(%s, %s, %s, %s)
"""
)

# One element of the last read, checked before anything is done with it.
TOUCH = (
    HELPERS
    + r"""
(function (snap, i, how, text, replace) {
  function no(code, message) { return JSON.stringify({ error: code, message: message }); }
  var kept = globalThis.__benchMCP;
  if (!kept || kept.snap !== snap) return no('stale_element', 'The page has changed since that read_page');
  var el = kept.els[i];
  if (!el || !el.isConnected) return no('detached', 'That element is no longer in the page');
  if (how === 'click') {
    if (el.disabled) return no('disabled', 'That element is disabled');
    el.scrollIntoView({ block: 'center', inline: 'center' });
    var r = el.getBoundingClientRect();
    if (!r.width || !r.height || !visible(el)) return no('not_visible', 'That element is hidden');
    var x = r.left + r.width / 2, y = r.top + r.height / 2;
    if (x < 0 || y < 0 || x >= innerWidth || y >= innerHeight) return no('out_of_view', 'That element cannot be scrolled into view');
    var hit = document.elementFromPoint(x, y);
    while (hit && hit.shadowRoot) {
      var deeper = hit.shadowRoot.elementFromPoint(x, y);
      if (!deeper || deeper === hit) break;
      hit = deeper;
    }
    var label = hit && hit.closest ? hit.closest('label') : null;
    if (!hit || !(hit === el || el.contains(hit) || (label && label.control === el)))
      return no('obscured', 'Covered by ' + (hit ? described(hit) : 'nothing at its middle'));
    // A selector naming exactly this element, for the bench's real click;
    // none inside a shadow root, which a selector can't reach.
    var q = null;
    if (el.getRootNode() === document) {
      var parts = [];
      for (var n = el; n && n !== document.documentElement; n = n.parentElement) {
        var k = 1;
        for (var p = n.previousElementSibling; p; p = p.previousElementSibling) if (p.tagName === n.tagName) k++;
        parts.unshift(n.tagName.toLowerCase() + ':nth-of-type(' + k + ')');
      }
      parts.unshift('html');
      q = parts.join(' > ');
      if (document.querySelector(q) !== el) q = null;
    }
    return JSON.stringify({ ok: true, selector: q, at: [Math.round(x), Math.round(y)] });
  }
  if (how === 'press') { el.click(); return JSON.stringify({ ok: true }); }
  if (!editable(el)) return no('not_editable', 'That element is not a text field');
  if (el.disabled || el.readOnly) return no('not_editable', 'That field is disabled or read-only');
  var before = el.isContentEditable ? el.textContent : el.value;
  var want = replace ? text : before + text;
  if (how === 'focus') {
    el.scrollIntoView({ block: 'center', inline: 'nearest' });
    el.focus();
    if (replace) {
      if (el.isContentEditable) getSelection().selectAllChildren(el);
      else if (el.select) el.select();
    } else if (!el.isContentEditable && el.setSelectionRange) {
      try { el.setSelectionRange(el.value.length, el.value.length); } catch (e) {}
    }
    return JSON.stringify({ ok: true, want: want });
  }
  if (how === 'set') {
    el.focus();
    // Through the field's own setter, with the events a keystroke fires,
    // as ./bench type does, so frameworks notice.
    if (el.isContentEditable) {
      el.textContent = want;
      el.dispatchEvent(new InputEvent('input', { bubbles: true, data: text, inputType: 'insertText' }));
    } else {
      var proto = el.tagName === 'TEXTAREA' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
      var setter = Object.getOwnPropertyDescriptor(proto, 'value');
      if (setter && setter.set) setter.set.call(el, want); else el.value = want;
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }
  if (how === 'submit') {
    var form = el.form || el.closest('form');
    if (!form) return no('no_form', 'That field is in no form');
    if (form.requestSubmit) form.requestSubmit(); else form.submit();
    return JSON.stringify({ ok: true });
  }
  var got = el.isContentEditable ? el.textContent : el.value;
  var out = { ok: true, verified: got === (how === 'verify' ? text : want) };
  if (!out.verified && !secret(el)) out.holds = String(got).slice(0, 500);
  return JSON.stringify(out);
})(%s, %s, %s, %s, %s)
"""
)

CHECK = (
    HELPERS
    + r"""
(function (c) {
  var ok = true;
  try {
    if (c.text != null) ok = ok && !!document.body && document.body.innerText.indexOf(c.text) !== -1;
    if (c.url != null) ok = ok && location.href.indexOf(c.url) !== -1;
    if (c.selector != null) { var e = document.querySelector(c.selector); ok = ok && !!e && visible(e); }
    if (c.role != null || c.name != null) {
      var want = c.name == null ? null : String(c.name).toLowerCase();
      ok = ok && candidates().some(function (el) {
        var r = wanted(el);
        return r && (c.role == null || r === c.role) &&
          (want == null || name(el).toLowerCase().indexOf(want) !== -1) && visible(el);
      });
    }
  } catch (e) {
    return JSON.stringify({ error: 'bad_condition', message: String(e && e.message || e) });
  }
  return JSON.stringify({ met: c.gone ? !ok : ok, url: location.href, title: document.title });
})(%s)
"""
)


def js(value):
    return json.dumps(value)


# MARK: - sessions


class Session:
    def __init__(self, world, ephemeral, lease):
        self.id = "ses_" + secrets.token_hex(4)
        self.world = world
        self.ephemeral = ephemeral
        self.lease = lease
        self.launched = False
        self.pids = set()
        self.pages = {}  # p1 → the tab's id, as the bench prints it
        self.snaps = {}  # p1 → the number of its last read_page
        self.counter = 0

    def adopt(self, tab):
        for handle, id in self.pages.items():
            if id == tab:
                return handle
        self.counter += 1
        handle = f"p{self.counter}"
        self.pages[handle] = tab
        return handle

    def forget(self, handle):
        self.pages.pop(handle, None)
        self.snaps.pop(handle, None)

    def tab(self, handle):
        if handle not in self.pages:
            raise Refusal("stale_page", f"No page {handle!r} in this session", "Use list_tabs or open_tab.")
        return self.pages[handle]

    def ask(self, request, patience=35.0):
        # Whoever holds the socket now must be the process this session
        # started: a world that died and came back under someone else, or
        # a socket file swapped underneath, gets nothing.
        held = holding(self.world)
        if not self.pids or not held or not held <= self.pids:
            raise Refusal(
                "not_ours",
                f"Search ({self.world}) is no longer the process this session started",
                "close_session, then open_session.",
            )
        return ask(self.world, request, patience)

    def page_js(self, handle, script, patience=35.0):
        """A script in Search's own world on that page → what it returned."""
        answer = self.ask({"do": "eval", "id": self.tab(handle), "js": script, "world": "search"}, patience)
        value = answer.get("value")
        try:
            out = json.loads(value) if isinstance(value, str) else value
        except ValueError:
            out = value
        if isinstance(out, dict) and "error" in out:
            raise Refusal(
                out["error"],
                out.get("message", ""),
                "Call read_page again." if out["error"] in ("stale_element", "detached") else "",
            )
        return out

    def state(self, handle, answer):
        out = {
            "page": handle,
            "url": answer.get("url", ""),
            "title": answer.get("title", ""),
            "loading": bool(answer.get("loading")),
        }
        if answer.get("failure"):
            out["failure"] = answer["failure"]
        if answer.get("timeout"):
            out["timeout"] = True
        return out

    def settle(self, handle, seconds):
        return self.state(handle, self.ask({"do": "wait", "id": self.tab(handle), "seconds": seconds}, seconds + 15))


sessions = {}


def session_of(args):
    id = args.get("session")
    if id not in sessions:
        raise Refusal("stale_session", "That session is closed or belongs to another server", "Use open_session.")
    return sessions[id]


def element_of(s, args):
    m = re.fullmatch(r"(p\d+)\.s(\d+)\.e(\d+)", str(args.get("element", "")))
    if not m:
        raise Refusal("bad_handle", "An element handle looks like p1.s3.e12, from read_page")
    page, snap, index = m.group(1), int(m.group(2)), int(m.group(3))
    s.tab(page)
    if s.snaps.get(page) != snap:
        raise Refusal("stale_element", "That handle is from an earlier read_page", "Call read_page again.")
    return page, snap, index


def take_lease(world):
    os.makedirs(LEASES, mode=0o700, exist_ok=True)
    fd = os.open(f"{LEASES}/{world}.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise Refusal(
            "world_busy",
            f"Another controller has Search ({world})",
            "Use another world, or open_session with no world for one of your own.",
        ) from None
    return fd


def launch(s):
    if not os.path.isdir(APP):
        raise Refusal("no_build", f"There is no {APP}", "Build it first: ./build.sh")
    # Someone's own Search running from this very build: no probe starts
    # beside it (Tests/split_view.py says why).
    if any(not probe(p) for p in running()):
        raise Refusal(
            "app_in_use",
            f"{APP} is open as someone's browser, not a test run",
            "Run from a worktree with a build of its own.",
        )
    # The switch before the launch, or the world opens in front (fresh.sh).
    for key in ("bench", "welcomed"):
        subprocess.run(["defaults", "write", suite(s.world), key, "-bool", "true"], check=True)
    sock = socket_of(s.world)
    if os.path.exists(sock):
        os.remove(sock)
    before = running()
    subprocess.run(["open", "-n", "-g", "-j", "--env", f"SEARCH_PROBE={s.world}", APP], check=True)
    s.launched = True
    for _ in range(300):
        if listening(s.world):
            break
        time.sleep(0.1)
    else:
        raise Refusal("not_listening", f"Search ({s.world}) didn't start listening within 30 s")
    s.pids = (running() - before) & holding(s.world)
    if not s.pids:
        raise Refusal("not_ours", f"Search ({s.world}) is listening, but not from the process just started")


def quit_world(s):
    try:
        s.ask({"do": "quit"}, patience=10)
    except (Refusal, OSError, ValueError):
        pass
    for _ in range(40):
        if not (s.pids & running()):
            break
        time.sleep(0.2)
    for pid in s.pids & running():
        if probe(pid):
            subprocess.run(["kill", pid], check=False)


def finish(s):
    """Quit what the session started, wipe what it named, and let go of
    the world."""
    sessions.pop(s.id, None)
    if s.launched:
        quit_world(s)
        if s.ephemeral:
            time.sleep(0.5)
            wipe(s.world)
    os.close(s.lease)


# MARK: - the tools


def tool_open_session(args):
    given = args.get("world")
    world = named(given) if given else "agent-" + secrets.token_hex(3)
    ephemeral = not given and not args.get("keep", False)
    lease = take_lease(world)
    s = Session(world, ephemeral, lease)
    try:
        # Only a world this server starts: one already open is somebody
        # else's, a test run or a fresh.sh window, and stays theirs.
        if listening(world) or holding(world):
            raise Refusal(
                "world_in_use",
                f"Search ({world}) is already open, and this server only drives worlds it starts",
                "Quit that one, or open_session with no world for one of your own.",
            )
        launch(s)
        tabs = s.ask({"do": "tabs"}).get("tabs", [])
    except BaseException:
        if s.launched:
            quit_world(s)
            if ephemeral:
                wipe(world)
        os.close(lease)
        raise
    sessions[s.id] = s
    return {
        "session": s.id,
        "world": world,
        "started": s.launched,
        "wipedOnClose": ephemeral,
        "tabs": [{"page": s.adopt(t["id"]), "url": t.get("url", ""), "title": t.get("title", "")} for t in tabs],
    }


def tool_close_session(args):
    s = session_of(args)
    finish(s)
    return {"closed": s.id, "world": s.world, "quit": s.launched, "wiped": s.launched and s.ephemeral}


def tool_list_tabs(args):
    s = session_of(args)
    tabs = s.ask({"do": "tabs"}).get("tabs", [])
    live = {t["id"] for t in tabs}
    for handle in [h for h, id in s.pages.items() if id not in live]:
        s.forget(handle)
    return {
        "tabs": [
            {
                "page": s.adopt(t["id"]),
                "url": t.get("url", ""),
                "title": t.get("title", ""),
                "loading": bool(t.get("loading")),
                "bench": bool(t.get("bench")),
            }
            for t in tabs
        ]
    }


def tool_open_tab(args):
    s = session_of(args)
    answer = s.ask({"do": "open", "url": str(args.get("url", ""))})
    handle = s.adopt(answer["id"])
    if args.get("wait", True):
        return s.settle(handle, float(args.get("timeout", 20)))
    return s.state(handle, answer)


def tool_close_tab(args):
    s = session_of(args)
    handle = str(args.get("page", ""))
    s.ask({"do": "close", "id": s.tab(handle)})
    s.forget(handle)
    return {"closed": handle}


def tool_navigate(args):
    s = session_of(args)
    handle = str(args.get("page", ""))
    s.ask({"do": "go", "id": s.tab(handle), "url": str(args.get("url", ""))})
    time.sleep(0.2)
    return s.settle(handle, float(args.get("timeout", 20)))


def history_step(args, step):
    s = session_of(args)
    handle = str(args.get("page", ""))
    s.ask({"do": "eval", "id": s.tab(handle), "js": f"history.{step}(); true"})
    time.sleep(0.3)
    return s.settle(handle, float(args.get("timeout", 20)))


def tool_read_page(args):
    s = session_of(args)
    handle = str(args.get("page", ""))
    snap = s.snaps.get(handle, 0) + 1
    out = s.page_js(
        handle,
        READ
        % (snap, int(args.get("max_nodes", 300)), int(args.get("max_text", 20000)), js(bool(args.get("text", True)))),
    )
    s.snaps[handle] = snap
    for node in out.get("nodes", []):
        node["element"] = f"{handle}.s{snap}.e{node.pop('e')}"
    out["page"] = handle
    return out


def tool_click(args):
    s = session_of(args)
    page, snap, index = element_of(s, args)
    tab = s.tab(page)
    url = s.ask({"do": "wait", "id": tab, "seconds": 0}).get("url", "")
    seen = s.page_js(page, TOUCH % (snap, index, js("click"), js(""), "true"))
    trusted = bool(seen.get("selector")) and bool(args.get("trusted", True))
    if trusted:
        s.ask({"do": "tap", "id": tab, "selector": seen["selector"]})
    else:
        s.page_js(page, TOUCH % (snap, index, js("press"), js(""), "true"))
    time.sleep(0.3)
    out = s.settle(page, float(args.get("timeout", 10)))
    out.update(trusted=trusted, at=seen.get("at"), navigated=out["url"] != url)
    return out


def tool_type(args):
    s = session_of(args)
    page, snap, index = element_of(s, args)
    text, replace = str(args.get("text", "")), bool(args.get("replace", True))
    if args.get("keys", False):
        # Real key events (the bench's key), into the field after focusing it.
        want = s.page_js(page, TOUCH % (snap, index, js("focus"), js(text), js(replace)))["want"]
        s.ask({"do": "key", "id": s.tab(page), "text": text})
        out = s.page_js(page, TOUCH % (snap, index, js("verify"), js(want), js(replace)))
    else:
        out = s.page_js(page, TOUCH % (snap, index, js("set"), js(text), js(replace)))
    if args.get("submit", False):
        s.page_js(page, TOUCH % (snap, index, js("submit"), js(""), "true"))
        time.sleep(0.3)
        out.update(s.settle(page, float(args.get("timeout", 10))))
    return out


def tool_wait_for(args):
    s = session_of(args)
    handle = str(args.get("page", ""))
    timeout = float(args.get("timeout", 10))
    keys = ("text", "url", "selector", "role", "name")
    condition = {k: args[k] for k in keys if args.get(k) is not None}
    if not condition:
        out = s.settle(handle, timeout)
        if out.get("timeout"):
            raise Refusal("timeout", f"Still loading after {timeout:g} s")
        return out
    condition["gone"] = bool(args.get("gone", False))
    began = time.monotonic()
    last = None
    while True:
        try:
            last = s.page_js(handle, CHECK % js(condition), patience=10)
            if last.get("met"):
                return {
                    "met": True,
                    "page": handle,
                    "url": last.get("url", ""),
                    "title": last.get("title", ""),
                    "waitedMs": int((time.monotonic() - began) * 1000),
                }
        except Refusal as refusal:
            # A page between documents has nothing to evaluate in yet.
            if refusal.code not in ("bench", "no_answer"):
                raise
        if time.monotonic() - began >= timeout:
            raise Refusal(
                "timeout",
                f"Not met within {timeout:g} s: {json.dumps(condition)}",
                "Nothing was repeated. read_page to see where the page is.",
            )
        time.sleep(0.25)


def tool_screenshot(args):
    s = session_of(args)
    handle = str(args.get("page", ""))
    room = tempfile.mkdtemp(prefix="search-bench-mcp-")
    try:
        request = {"do": "shot", "id": s.tab(handle), "path": f"{room}/page.png"}
        if args.get("width"):
            request["width"] = float(args["width"])
        answer = s.ask(request)
        data = Path(answer["path"]).read_bytes()
    finally:
        shutil.rmtree(room, ignore_errors=True)
    view = s.ask({"do": "eval", "id": s.tab(handle), "js": "[innerWidth, innerHeight, devicePixelRatio]"}).get("value")
    about = {"page": handle, "pixels": [answer.get("width"), answer.get("height")]}
    if isinstance(view, list) and len(view) == 3:
        about.update(viewport=view[:2], devicePixelRatio=view[2])
    return [
        {"type": "image", "data": base64.b64encode(data).decode(), "mimeType": "image/png"},
        {"type": "text", "text": json.dumps(about)},
    ]


def tool_evaluate(args):
    s = session_of(args)
    handle = str(args.get("page", ""))
    return {"value": s.ask({"do": "eval", "id": s.tab(handle), "js": str(args.get("js", ""))}).get("value")}


def tool_window_state(args):
    return session_of(args).ask({"do": "probe"})


def tool_bench(args):
    s = session_of(args)
    request = args.get("request")
    if not isinstance(request, dict) or not isinstance(request.get("do"), str):
        raise Refusal("bad_request", 'request is a ./bench socket request, such as {"do": "tabs"}')
    if request["do"] == "quit":
        raise Refusal("bad_request", "close_session quits the world")
    # The updater swaps the app it runs from: this checkout's build, which may
    # be the browser someone uses every day. Nothing a session drives reaches it.
    if request["do"] == "update":
        raise Refusal("bad_request", "updates aren't driven from a session")
    request = dict(request)
    if request.get("id") in s.pages:
        request["id"] = s.pages[request["id"]]
    return s.ask(request, float(args.get("patience", 35)))


