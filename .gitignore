# Build output — build.sh regenerates all of this.
.build/
build/
.swiftpm/
*.xcuserstate
.DS_Store

# Python's bytecode cache, left in Tests/ by the probe scripts.
__pycache__/

# Signing material that's tied to one Apple Developer account and should
# never be committed, even though the scripts happily run without it.
*.provisionprofile
*.p12
*.mobileprovision

# Standalone Midscene desktop E2E harness.
Tests/Midscene/node_modules/
Tests/Midscene/midscene_run/
Tests/Midscene/.midscene/
Tests/Midscene/.env
Tests/Midscene/summary.md
Tests/Midscene/midscene-node-spec.*.md
Tests/Midscene/desktop-health/
