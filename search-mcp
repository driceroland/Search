#!/usr/bin/env python3
"""The Search you have open, for a coding agent: an MCP server over stdio.

    claude mcp add search -- /path/to/Search/search-mcp
    codex mcp add search -- /path/to/Search/search-mcp

Turn on Settings › About › Developer › "Let coding agents use Search" first.
Search then listens on agent.sock in its own folder, for this user only, and
this server is what an agent runs to speak to it: one JSON-RPC message per
line on stdio, nothing but the standard library, and one connection to
Search, opened at the first tool call, not before.

That first call puts a question in Search's window: "<agent> wants to use
Search", Allow or Don't Allow. It waits for the answer (two minutes at a
time; a call after that goes on waiting). Allowed, the agent works in tabs
of its own, and the window says so until the agent is done or the person
presses Stop. Everything that matters is decided in Search, not here: what
an agent may read or touch, which tabs, which addresses, what is kept back
(passwords, card numbers, one-time codes, private tabs). This only passes
requests along and says what came back.

The tools follow ./bench-mcp's names and contract (ArcMod's computer-use
tools): a handle names one thing and fails rather than finds a substitute;
read_page gives roles, names, values and boxes; clicks are real mouse
events; typing is checked against the field; wait_for waits on a named
condition; one controller at a time.

    search-mcp --world NAME    a test world's Search (SEARCH_PROBE=NAME)
"""

from __future__ import annotations

import json
import os
import signal
import socket
import stat
import sys

HOME = os.path.expanduser("~")
VERSIONS = ["2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"]
# How long a call waits for the person to answer the question in the window.
ASKING = 120.0


def world_from_args():
    args = sys.argv[1:]
    if "--world" in args and args.index("--world") + 1 < len(args):
        return args[args.index("--world") + 1]
    return os.environ.get("SEARCH_PROBE")


def folder(world):
    if not world:
        return f"{HOME}/Library/Application Support/Search"
    # As Store.world makes the name.
    world = "".join(c for c in str(world).lower() if c.isascii() and (c.isalnum() or c == "-"))
    return f"{HOME}/Library/Application Support/Search ({'test' if world in ('', '1') else world})"


SOCKET = f"{folder(world_from_args())}/Agent/agent.sock"


def yours(path):
    """The socket, and its folder, are this user's and nothing else: a
    socket, not a link, in a folder only this user can open. Anything else
    could be some other program standing in for Search."""
    try:
        sock, room = os.lstat(path), os.lstat(os.path.dirname(path))
    except OSError:
        return False
    return (
        stat.S_ISSOCK(sock.st_mode)
        and sock.st_uid == os.getuid()
        and stat.S_ISDIR(room.st_mode)
        and room.st_uid == os.getuid()
        and stat.S_IMODE(room.st_mode) & 0o077 == 0
    )


class Refusal(Exception):
    def __init__(self, code, message, hint=""):
        super().__init__(message)
        self.code, self.message, self.hint = code, message, hint

    def said(self):
        out = {"code": self.code, "message": self.message}
        if self.hint:
            out["hint"] = self.hint
        return {"error": out}


def log(*words):
    print("search-mcp:", *words, file=sys.stderr, flush=True)


# MARK: - the connection


class Search:
    """One connection to Search, opened when first needed, and the question
    it puts to the person."""

    def __init__(self):
        self.sock = None
        self.buffer = b""
        self.counter = 0
        self.client = "A coding agent"
        # The hello whose answer hasn't come: the person hasn't answered yet.
        self.asking = None

    def connect(self):
        if os.path.lexists(SOCKET) and not yours(SOCKET):
            raise Refusal(
                "not_search",
                "The socket isn't one Search made for this user",
                "Don't use it. Turning the setting off and on again in Search makes it afresh.",
            )
        if not os.path.exists(SOCKET):
            raise Refusal(
                "not_listening",
                "Search isn't open for coding agents",
                'Ask the person to turn on Settings › About › Developer › "Let coding agents use Search".',
            )
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(SOCKET)
        except OSError:
            s.close()
            raise Refusal("not_listening", "Search isn't open for coding agents", "Is Search running?") from None
        # Search turns a connection away at once (another agent, or just
        # told no): read that before saying anything, or the hello would
        # meet a closed socket and the reason would be lost.
        s.settimeout(0.3)
        try:
            early = s.recv(1 << 16)
        except socket.timeout:  # noqa: UP041
            early = None
        except OSError:
            early = b""
        if early is not None:
            s.close()
            try:
                error = json.loads(early.split(b"\n", 1)[0]).get("error", {})
            except ValueError:
                error = {}
            raise Refusal(error.get("code", "stopped"), error.get("message", "Search closed the connection"),
                          error.get("hint", ""))
        self.sock, self.buffer = s, b""
        self.asking = self.send({"do": "hello", "client": self.client})

    def drop(self):
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock, self.asking, self.buffer = None, None, b""

    def send(self, request):
        self.counter += 1
        request = dict(request, n=self.counter)
        try:
            self.sock.sendall((json.dumps(request) + "\n").encode())
        except OSError:
            self.drop()
            raise Refusal("stopped", "The connection to Search is gone", "Call again to ask once more.") from None
        return self.counter

    def receive(self, n, patience):
        """The answer to request n, or None if it hasn't come in time."""
        self.sock.settimeout(patience)
        while True:
            while b"\n" in self.buffer:
                line, self.buffer = self.buffer.split(b"\n", 1)
                try:
                    answer = json.loads(line)
                except ValueError:
                    continue
                # An answer with no number is Search refusing the connection.
                if answer.get("n") in (n, None):
                    return answer
            try:
                chunk = self.sock.recv(1 << 20)
            except socket.timeout:  # noqa: UP041 (TimeoutError only from 3.10)
                return None
            except OSError:
                chunk = b""
            if not chunk:
                self.drop()
                raise Refusal(
                    "stopped",
                    "Search ended the connection: the person pressed Stop, said no, or turned the setting off",
                    "Don't ask again unless the person says so.",
                )
            self.buffer += chunk

    def wait_for_answer(self):
        if self.asking is None:
            return
        answer = self.receive(self.asking, ASKING)
        if answer is None:
            raise Refusal(
                "waiting_for_person",
                "Search is still asking the person whether you may use it",
                "Tell the person to look at Search's window, then call again.",
            )
        self.asking = None
        if "error" in answer:
            self.drop()
            error = answer["error"]
            raise Refusal(error.get("code", "not_allowed"), error.get("message", ""), error.get("hint", ""))

    def ask(self, request, patience=60.0):
        if self.sock is None:
            self.connect()
        self.wait_for_answer()
        answer = self.receive(self.send(request), patience)
        if answer is None:
            raise Refusal("no_answer", f"{request.get('do')} got no answer within {int(patience)} s")
        answer.pop("n", None)
        if "error" in answer:
            error = answer["error"]
            if isinstance(error, dict):
                raise Refusal(error.get("code", "search"), error.get("message", ""), error.get("hint", ""))
            raise Refusal("search", str(error))
        return answer


search = Search()


# MARK: - the tools


def passing(verb, keys):
    """A tool that hands its arguments to one of Search's verbs as they are."""

    def tool(args):
        request = {"do": verb}
        request.update({k: args[k] for k in keys if k in args})
        return search.ask(request, float(args.get("timeout", 20)) + 30)

    return tool


def tool_screenshot(args):
    request = {"do": "shot", "page": args.get("page", "")}
    if args.get("width"):
        request["width"] = float(args["width"])
    answer = search.ask(request)
    data = answer.pop("png", "")
    return [
        {"type": "image", "data": data, "mimeType": "image/png"},
        {"type": "text", "text": json.dumps(answer)},
    ]


def tool_disconnect(_args):
    if search.sock is None:
        return {"disconnected": True}
    try:
        search.ask({"do": "bye"}, 5)
    except Refusal:
        pass
    search.drop()
    return {"disconnected": True}


