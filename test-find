#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
scratch_dir=$(mktemp -d "${TMPDIR:-/tmp}/search-page-find.XXXXXX")
trap 'rm -rf "$scratch_dir"' EXIT HUP INT TERM

xcrun swiftc -swift-version 5 -parse-as-library \
  "$repo_dir/Sources/Search/PageFind.swift" \
  "$repo_dir/Tests/PageFindHarness.swift" \
  -o "$scratch_dir/PageFindTests"
"$scratch_dir/PageFindTests"
